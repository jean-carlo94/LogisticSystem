# PostgreSQL Database
POSTGRES_USER=logistic_system_user
POSTGRES_PASSWORD=
POSTGRES_DB=logistic_system_db

# Security (min 32 chars, use: openssl rand -base64 48)
SECRET_KEY=

# Admin user (created on first boot, leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API
API_V1_STR=/api/v1
PROJECT_NAME=Logistic System API
APP_PORT=8000
ACCESS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=["https://tu-dominio.com"]
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60
REQUEST_BODY_MAX_SIZE_MB=5

# Storage: "local" o "s3"
STORAGE_BACKEND=local
STORAGE_PATH=static/uploads

# S3 / R2 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tu-dominio.com
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_ACTIVATION_EXPIRE_HOURS=24
FRONTEND_URL=https://tu-dominio.com

# Database pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# PDF Rendering (weasyprint | gotenberg | custom)
PDF_RENDERER=weasyprint
PDF_SERVICE_URL=
PDF_CONCURRENCY_LIMIT=5
