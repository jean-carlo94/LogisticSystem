# PostgreSQL Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
#DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Security
SECRET_KEY=

# API
API_V1_STR=/api/v1
PROJECT_NAME=Logistic System API
APP_PORT=8000

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=static/uploads

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
