# PostgreSQL Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
#DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Security (min 32 chars for SECRET_KEY)
SECRET_KEY=

# Admin user (created on first boot, leave empty to skip)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API
API_V1_STR=/api/v1
PROJECT_NAME=Logistic System API
APP_PORT=8000
REQUEST_BODY_MAX_SIZE_MB=10

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=static/uploads

# S3 / R2 (only needed when STORAGE_BACKEND=s3)
# R2 example: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2 example: S3_PUBLIC_URL=https://pub-<hash>.r2.dev  or  your custom domain
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tudominio.com
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ACCOUNT_ACTIVATION_EXPIRE_HOURS=24
FRONTEND_URL=http://localhost:3000
