{
  "_version": "0.3.0",
  "_guia": "Documento para agente frontend. Cada endpoint tiene request/response shapes y reglas de negocio relevantes al consumir la API.",

  "base_url": "http://localhost:8000/api/v1",
  "auth_header": "Authorization: Bearer {token}",
  "content_type": "application/json",
  "content_type_upload": "multipart/form-data",

  "respuestas_de_error": {
    "400": { "detail": "string — mensaje de validación" },
    "401": { "detail": "No autorizado" },
    "403": { "detail": "Acceso denegado" },
    "404": { "detail": "Recurso no encontrado" },
    "409": { "detail": "string — conflicto (duplicado, restricción)" },
    "422": "FastAPI validation error (campos inválidos)"
  },

  "paginacion": {
    "request_query": { "page": "int (default 1)", "size": "int (default 20, max 100)" },
    "response_shape": {
      "items": "list<T>",
      "total": "int",
      "page": "int",
      "size": "int",
      "pages": "int"
    }
  },

  "filtros": {
    "_resumen": "TODAS las propiedades de cualquier entidad son filtrables. Pasas cualquier query param y el sistema lo convierte al tipo correcto automáticamente.",
    "comportamiento_por_tipo": {
      "String": "ILIKE %valor% — case-insensitive, búsqueda parcial en cualquier parte del texto",
      "Text": "ILIKE %valor% — igual que String",
      "Integer": "== exacto — debe coincidir el número completo",
      "Float": "== exacto — debe coincidir el número completo",
      "Boolean": "== exacto — true|false (acepta: true/false, 1/0, yes/no)",
      "Enum": "== exacto — debe coincidir el valor del enum (ej: ACTIVE)",
      "DateTime": "no soportado como filtro"
    },
    "campos_bloqueados": {
      "User.hashed_password": "ignorado, nunca filtra por seguridad"
    },
    "combinacion": "Múltiples filtros se combinan con AND. Parámetros page/size están reservados y no se usan como filtro.",
    "propiedades_con_setter": "Campos como Product.name, Product.price, Product.stock usan @property. El sistema los resuelve automáticamente al atributo privado (_name, _price, _stock). El frontend usa siempre el nombre público.",

    "documentados_en_swagger": "Los campos seriales (unique) aparecen como Query params visibles en /docs. El resto funciona igual aunque no se vean en Swagger."
  },

  "filtros_por_entidad": {
    "products": {
      "documentado_swagger": "barcode",
      "todos_los_campos": {
        "barcode": { "tipo": "string", "ejemplo": "?barcode=BAR-001" },
        "name": { "tipo": "string (ILIKE)", "ejemplo": "?name=tornillo" },
        "description": { "tipo": "string (ILIKE)", "ejemplo": "?description=acero" },
        "price": { "tipo": "float (=)", "ejemplo": "?price=15.0" },
        "stock": { "tipo": "int (=)", "ejemplo": "?stock=100" },
        "state": { "tipo": "enum (=)", "ejemplo": "?state=ACTIVE" },
        "weight_kg": { "tipo": "float (=)", "ejemplo": "?weight_kg=2" },
        "width_cm": { "tipo": "float (=)", "ejemplo": "?width_cm=5" },
        "height_cm": { "tipo": "float (=)", "ejemplo": "?height_cm=5" },
        "depth_cm": { "tipo": "float (=)", "ejemplo": "?depth_cm=5" },
        "image_path": { "tipo": "string (ILIKE)", "ejemplo": "?image_path=products/x.jpg" },
        "id": { "tipo": "int (=)", "ejemplo": "?id=1" }
      },
      "ejemplos_combinados": [
        "GET /products/?state=ACTIVE&stock=100",
        "GET /products/?name=tornillo&price=0.5",
        "GET /products/?barcode=BAR-001",
        "GET /products/?name=mart (encuentra 'Martillo grande')"
      ]
    },
    "users": {
      "documentado_swagger": "email",
      "todos_los_campos": {
        "email": { "tipo": "string (ILIKE)", "ejemplo": "?email=admin" },
        "first_name": { "tipo": "string (ILIKE)", "ejemplo": "?first_name=Admin" },
        "last_name": { "tipo": "string (ILIKE)", "ejemplo": "?last_name=Lopez" },
        "phone": { "tipo": "string (ILIKE)", "ejemplo": "?phone=+569" },
        "city": { "tipo": "string (ILIKE)", "ejemplo": "?city=Santiago" },
        "country": { "tipo": "string (ILIKE)", "ejemplo": "?country=Chile" },
        "is_active": { "tipo": "bool (=)", "ejemplo": "?is_active=true" },
        "is_super_admin": { "tipo": "bool (=)", "ejemplo": "?is_super_admin=false" },
        "image_path": { "tipo": "string (ILIKE)", "ejemplo": "?image_path=users/x.jpg" },
        "id": { "tipo": "int (=)", "ejemplo": "?id=1" },
        "hashed_password": { "tipo": "BLOQUEADO — ignorado" }
      },
      "ejemplos_combinados": [
        "GET /users/?is_active=true&country=Chile",
        "GET /users/?email=admin@logistics.com",
        "GET /users/?first_name=Admin&city=santiago (ILIKE encuentra 'Santiago')"
      ]
    },
    "shelves": {
      "documentado_swagger": "code",
      "todos_los_campos": {
        "code": { "tipo": "string (ILIKE)", "ejemplo": "?code=A-01" },
        "name": { "tipo": "string (ILIKE)", "ejemplo": "?name=estante" },
        "aisle": { "tipo": "string (ILIKE)", "ejemplo": "?aisle=A" },
        "row": { "tipo": "int (=)", "ejemplo": "?row=1" },
        "level": { "tipo": "int (=)", "ejemplo": "?level=3" },
        "max_weight_kg": { "tipo": "float (=)", "ejemplo": "?max_weight_kg=200" },
        "width_cm": { "tipo": "float (=)", "ejemplo": "?width_cm=100" },
        "height_cm": { "tipo": "float (=)", "ejemplo": "?height_cm=50" },
        "depth_cm": { "tipo": "float (=)", "ejemplo": "?depth_cm=40" },
        "id": { "tipo": "int (=)", "ejemplo": "?id=1" }
      },
      "ejemplos_combinados": [
        "GET /shelves/?aisle=A&row=1",
        "GET /shelves/?code=A-01-01",
        "GET /shelves/?name=estante+principal (ILIKE)",
        "GET /shelves/?level=3&max_weight_kg=200"
      ]
    },
    "roles": {
      "documentado_swagger": "name",
      "todos_los_campos": {
        "name": { "tipo": "string (ILIKE)", "ejemplo": "?name=admin" },
        "description": { "tipo": "string (ILIKE)", "ejemplo": "?description=admin" },
        "id": { "tipo": "int (=)", "ejemplo": "?id=1" }
      },
      "ejemplos_combinados": [
        "GET /roles/?name=Admin",
        "GET /roles/?description=rol"
      ]
    },
    "events": {
      "documentado_swagger": "ninguno (solo page/size)",
      "todos_los_campos": {
        "entity_type": { "tipo": "string (ILIKE)", "ejemplo": "?entity_type=Product" },
        "entity_id": { "tipo": "int (=)", "ejemplo": "?entity_id=1" },
        "action": { "tipo": "enum (=)", "ejemplo": "?action=CREATE" },
        "user_id": { "tipo": "int (=)", "ejemplo": "?user_id=1" },
        "description": { "tipo": "string (ILIKE)", "ejemplo": "?description=creado" },
        "id": { "tipo": "int (=)", "ejemplo": "?id=1" }
      },
      "ejemplos_combinados": [
        "GET /events/?action=CREATE&entity_type=Product",
        "GET /events/?user_id=1",
        "GET /events/?action=DELETE&entity_type=Product"
      ]
    }
  },

  "endpoints": {

    "products": {
      "list": {
        "method": "GET",
        "path": "/products/",
        "auth": "products_read",
        "query": {
          "page": "int",
          "size": "int",
          "barcode": "string — documentado en Swagger (único)",
          "_cualquier_otro_campo": "ver sección 'filtros_por_entidad.products'"
        },
        "response_shape": {
          "id": "int",
          "name": "string",
          "description": "string|null",
          "price": "float",
          "stock": "int",
          "state": "string",
          "barcode": "string|null",
          "weight_kg": "float",
          "width_cm": "float",
          "height_cm": "float",
          "depth_cm": "float",
          "image_path": "string|null",
          "image_url": "string|null (ej: /static/uploads/products/product_5_abc.jpg)",
          "create_at": "ISO8601 datetime",
          "update_at": "ISO8601 datetime"
        },
        "frontend_notes": [
          "image_url se construye concatenando el base_url del server. Si es null, mostrar placeholder.",
          "Para mostrar imagen: <img src='{base_url}{image_url}' />. El path ya incluye /static/.",
          "state es enum: ACTIVE (verde), INACTIVE (gris), NO_STOCK (rojo), DISCONTINUED (tachado).",
          "Para buscar: usa ?name=mart y encuentra 'Martillo' (ILIKE case-insensitive)."
        ]
      },

      "get_one": {
        "method": "GET",
        "path": "/products/{id}",
        "auth": "products_read",
        "response_shape": "mismo que list.items[0]"
      },

      "create": {
        "method": "POST",
        "path": "/products/",
        "auth": "products_create",
        "request_body": {
          "name": "string (1-200 chars, requerido)",
          "description": "string|null (opcional)",
          "price": "float (>0, requerido)",
          "stock": "int (>=0, default 0)",
          "state": "string (ACTIVE|INACTIVE|NO_STOCK|DISCONTINUED, default ACTIVE)",
          "barcode": "string|null (max 128, único. Empty string se convierte a null automáticamente)",
          "weight_kg": "float (>=0, default 0)",
          "width_cm": "float (>=0, default 0)",
          "height_cm": "float (>=0, default 0)",
          "depth_cm": "float (>=0, default 0)"
        },
        "response_shape": "mismo que list.items[0] (201 Created)",
        "errores": {
          "409": "Si barcode ya existe: 'El código de barras ya está en uso'"
        },
        "frontend_notes": [
          "stock=0 fuerza estado a NO_STOCK sin importar lo que envíes.",
          "barcode es único pero puede ser null (varios productos sin barcode OK). Enviar string vacío o whitespace → se guarda como null.",
          "weight/dimensions son para validación de estantería luego."
        ]
      },

      "update": {
        "method": "PUT",
        "path": "/products/{id}",
        "auth": "products_update",
        "request_body": "Todos los campos de create PERO todos son opcionales (partial update). Solo envía los campos que cambian.",
        "response_shape": "mismo que list.items[0]"
      },

      "delete": {
        "method": "DELETE",
        "path": "/products/{id}",
        "auth": "products_delete",
        "response": "204 No Content"
      },

      "upload_image": {
        "method": "POST",
        "path": "/products/{id}/image",
        "auth": "products_update",
        "content_type": "multipart/form-data",
        "request_body": { "file": "binary (campo del form llamado 'file')" },
        "response_shape": "mismo que product (con image_url actualizado)",
        "frontend_notes": [
          "Usa FormData: form.append('file', fileObject)",
          "Reemplaza imagen anterior automáticamente.",
          "La URL nueva viene en image_url del response."
        ]
      },

      "delete_image": {
        "method": "DELETE",
        "path": "/products/{id}/image",
        "auth": "products_update",
        "response": "204 No Content"
      },

      "qr": {
        "method": "GET",
        "path": "/products/{id}/qr",
        "auth": "products_read",
        "response_shape": {
          "product_id": "int",
          "name": "string",
          "barcode": "string|null",
          "shelf": {
            "code": "string (ej: A-01-03)",
            "aisle": "string (ej: A)",
            "row": "int (ej: 1)",
            "level": "int (ej: 3)"
          }
        },
        "frontend_notes": [
          "Usa esta data para renderizar un QR code en el frontend (librería qrcode.js o similar).",
          "shelf es null si el producto no está en ninguna estantería.",
          "Contenido típico del QR: JSON.stringify(response)."
        ]
      }
    },

    "users_auth": {
      "register": {
        "method": "POST",
        "path": "/auth/register",
        "auth": "público",
        "request_body": {
          "email": "string (email válido)",
          "password": "string (6-128 chars)",
          "first_name": "string|null",
          "last_name": "string|null",
          "phone": "string|null",
          "city": "string|null",
          "country": "string|null"
        },
        "response_shape": {
          "id": "int",
          "email": "string",
          "first_name": "string|null",
          "last_name": "string|null",
          "phone": "string|null",
          "city": "string|null",
          "country": "string|null",
          "is_active": "bool",
          "image_path": "string|null",
          "image_url": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        },
        "errores": { "409": "El email ya esta registrado" }
      },

      "login": {
        "method": "POST",
        "path": "/auth/login",
        "auth": "público",
        "request_body": {
          "email": "string (email válido)",
          "password": "string"
        },
        "response_shape": {
          "access_token": "string (JWT)",
          "token_type": "bearer"
        },
        "errores": { "401": "Email o contrasena incorrectos", "403": "Usuario inactivo" }
      },

      "me": {
        "method": "GET",
        "path": "/auth/me",
        "auth": "token requerido (cualquier usuario)",
        "response_shape": {
          "id": "int",
          "email": "string",
          "first_name": "string|null",
          "last_name": "string|null",
          "phone": "string|null",
          "city": "string|null",
          "country": "string|null",
          "is_active": "bool",
          "is_super_admin": "bool",
          "image_path": "string|null",
          "image_url": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601",
          "roles": [{"id": "int", "name": "string"}],
          "permissions": ["string (ej: products_read)"]
        },
        "frontend_notes": [
          "Usa permissions para mostrar/ocultar botones y rutas en el frontend.",
          "is_super_admin=true → tiene todos los permisos implícitamente.",
          "roles es lista de roles asignados (nombres tipo Admin, Operator, Viewer)."
        ]
      },

      "update_me": {
        "method": "PUT",
        "path": "/auth/me",
        "auth": "token requerido",
        "request_body": {
          "first_name": "string|null (opcional)",
          "last_name": "string|null (opcional)",
          "phone": "string|null (opcional)",
          "city": "string|null (opcional)",
          "country": "string|null (opcional)",
          "password": "string (6-128, opcional. Si se envía, cambia la contraseña)"
        },
        "response_shape": "mismo que login response (sin token)"
      },

      "upload_avatar": {
        "method": "POST",
        "path": "/auth/me/image",
        "auth": "token requerido",
        "content_type": "multipart/form-data",
        "request_body": { "file": "binary" },
        "response_shape": "mismo que user"
      },

      "delete_avatar": {
        "method": "DELETE",
        "path": "/auth/me/image",
        "auth": "token requerido",
        "response": "204 No Content"
      }
    },

    "users_admin": {
      "_nota": "Solo usuarios con permiso users_manage o super_admin",

      "list": {
        "method": "GET",
        "path": "/users/",
        "auth": "users_manage",
        "query": {
          "page": "int",
          "size": "int",
          "email": "string — documentado en Swagger (único)",
          "_cualquier_otro_campo": "ver sección 'filtros_por_entidad.users'"
        },
        "response_shape": {
          "id": "int",
          "email": "string",
          "first_name": "string|null",
          "last_name": "string|null",
          "phone": "string|null",
          "city": "string|null",
          "country": "string|null",
          "is_active": "bool",
          "is_super_admin": "bool",
          "image_path": "string|null",
          "image_url": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        },
        "frontend_notes": [
          "Email usa ILIKE: ?email=admin encuentra admin@logistics.com",
          "Nombres usan ILIKE: ?first_name=ad encuentra Admin",
          "hashed_password está bloqueado, se ignora si se envía como filtro."
        ]
      },

      "get_one": { "method": "GET", "path": "/users/{id}", "auth": "users_manage", "response_shape": "mismo que list.items[0]" },

      "update": {
        "method": "PUT",
        "path": "/users/{id}",
        "auth": "users_manage",
        "request_body": {
          "email": "string|null",
          "password": "string|null (6-128)",
          "first_name": "string|null",
          "last_name": "string|null",
          "phone": "string|null",
          "city": "string|null",
          "country": "string|null",
          "is_active": "bool|null"
        },
        "errores": { "409": "El email ya esta en uso" }
      },

      "delete": { "method": "DELETE", "path": "/users/{id}", "auth": "users_manage", "response": "204 No Content" },

      "upload_image": {
        "method": "POST",
        "path": "/users/{id}/image",
        "auth": "users_manage",
        "content_type": "multipart/form-data",
        "request_body": { "file": "binary" }
      },

      "delete_image": { "method": "DELETE", "path": "/users/{id}/image", "auth": "users_manage", "response": "204 No Content" },

      "get_roles": {
        "method": "GET",
        "path": "/users/{id}/roles",
        "auth": "users_manage",
        "response_shape": [{"id": "int", "name": "string"}]
      },

      "assign_role": {
        "method": "POST",
        "path": "/users/{id}/roles",
        "auth": "users_manage",
        "request_body": { "role_id": "int" },
        "response": "204 No Content"
      }
    },

    "shelves": {
      "_intro": "Las estanterías organizan los productos en la bodega. Cada producto puede estar en múltiples estanterías con cantidades parciales. El sistema valida dimensiones, peso, volumen y stock disponible. POST /items hace upsert (suma cantidad si ya existe).",

      "list": {
        "method": "GET",
        "path": "/shelves/",
        "auth": "shelves_read",
        "query": {
          "page": "int",
          "size": "int",
          "code": "string — documentado en Swagger (único)",
          "_cualquier_otro_campo": "ver sección 'filtros_por_entidad.shelves'"
        },
        "response_shape": {
          "id": "int",
          "name": "string (nombre descriptivo)",
          "code": "string (código único, ej: A-01-03)",
          "aisle": "string (pasillo, ej: A)",
          "row": "int (fila)",
          "level": "int (nivel/altura)",
          "max_weight_kg": "float (capacidad máxima de peso, 0=sin límite)",
          "width_cm": "float (ancho interno, 0=sin límite)",
          "height_cm": "float (alto interno, 0=sin límite)",
          "depth_cm": "float (fondo interno, 0=sin límite)",
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        },
        "frontend_notes": [
          "String fields con ILIKE: ?name=estante encuentra 'Estante A-1'",
          "Int/Float con exact match: ?row=1&level=3"
        ]
      },

      "get_detail": {
        "method": "GET",
        "path": "/shelves/{id}",
        "auth": "shelves_read",
        "response_shape": {
          "id": "int",
          "name": "string",
          "code": "string",
          "aisle": "string",
          "row": "int",
          "level": "int",
          "max_weight_kg": "float",
          "width_cm": "float",
          "height_cm": "float",
          "depth_cm": "float",
          "current_weight_kg": "float (peso total de productos asignados)",
          "current_volume_cm3": "float (volumen total ocupado: Σ(product_volume × quantity), redondeado 2 decimales)",
          "items": [
            {
              "id": "int (ID del shelf_item)",
              "shelf_id": "int",
              "product_id": "int",
              "product_name": "string",
              "quantity": "int"
            }
          ],
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        },
        "frontend_notes": [
          "current_weight_kg es la suma de (producto.weight_kg × item.quantity) para todos los items.",
          "current_volume_cm3 es la suma de (producto.width_cm × height_cm × depth_cm × quantity) para todos los items.",
          "items[] son los productos asignados a esta estantería con sus cantidades.",
          "Usa product_id para navegar al detalle del producto. product_name es solo para display."
        ]
      },

      "create": {
        "method": "POST",
        "path": "/shelves/",
        "auth": "shelves_create",
        "request_body": {
          "name": "string (1-100, requerido, ej: 'Estante A-1')",
          "code": "string (1-50, requerido, único, ej: 'A-01-03')",
          "aisle": "string (max 20, default '', ej: 'A')",
          "row": "int (>=0, default 0, ej: 1)",
          "level": "int (>=0, default 0, ej: 3)",
          "max_weight_kg": "float (>=0, default 0, ej: 200.0)",
          "width_cm": "float (>=0, default 0, ej: 100.0)",
          "height_cm": "float (>=0, default 0, ej: 50.0)",
          "depth_cm": "float (>=0, default 0, ej: 40.0)"
        },
        "response_shape": "mismo que list.items[0] (201 Created)",
        "errores": { "409": "El código de estantería ya existe" },
        "frontend_notes": [
          "code es como un SKU de la estantería — debe ser único. Define tu propio esquema (ej: PASILLO-FILA-NIVEL).",
          "Si max_weight_kg=0 o dimensiones en 0, esa validación se omite al asignar productos."
        ]
      },

      "update": {
        "method": "PUT",
        "path": "/shelves/{id}",
        "auth": "shelves_update",
        "request_body": "Todos los campos de create PERO opcionales (partial update).",
        "response_shape": "mismo que list.items[0]"
      },

      "delete": {
        "method": "DELETE",
        "path": "/shelves/{id}",
        "auth": "shelves_delete",
        "response": "204 No Content",
        "errores": {
          "409": "No se puede eliminar una estantería con productos asignados"
        },
        "frontend_notes": [
          "Antes de eliminar, debes vaciar la estantería (desasignar todos los items).",
          "Sugerencia UX: mostrar confirmación 'Esta estantería tiene X productos. ¿Moverlos primero?'"
        ]
      },

      "add_item": {
        "method": "POST",
        "path": "/shelves/{shelf_id}/items",
        "auth": "shelves_update",
        "request_body": {
          "product_id": "int (requerido)",
          "quantity": "int (>=1, default 1)"
        },
        "response_shape": {
          "id": "int",
          "shelf_id": "int",
          "product_id": "int",
          "product_name": "string (vacío en creación, se llena en GET detail)",
          "quantity": "int"
        },
        "errores": {
          "404": "Estantería o producto no encontrado",
          "400": "Error de capacidad o stock, ej: 'Ancho del producto (50cm) excede el de la estantería (40cm); Stock insuficiente: 10 en inventario, 8 ya asignados, 5 solicitados = 13 total'"
        },
        "upsert": {
          "_comportamiento": "Si el producto ya existe en la estantería, se suma la cantidad a la existente en vez de devolver 409. Se validan capacidad y stock para el nuevo total. Si falla, no se modifica nada."
        },
        "frontend_notes": [
          "La validación de capacidad y stock ocurre ANTES de guardar. Si falla, el item no se crea/modifica.",
          "Si el producto ya está en la estantería, se suma la cantidad (upsert). No hay error 409.",
          "Un producto puede estar en múltiples estanterías (ej: 10 unidades en A-01, 5 en B-03).",
          "La validación de stock considera TODAS las estanterías donde el producto está asignado."
        ]
      },

      "update_item": {
        "method": "PUT",
        "path": "/shelves/{shelf_id}/items/{item_id}",
        "auth": "shelves_update",
        "request_body": {
          "quantity": "int (>=0)"
        },
        "response_shape": "mismo que ShelfItemResponse",
        "errores": {
          "404": "Ítem no encontrado en esta estantería",
          "400": "Error de capacidad, volumen o stock (mismas validaciones que add_item)"
        },
        "frontend_notes": [
          "Si quantity=0, el item se elimina (mismo efecto que DELETE).",
          "La validación de capacidad, volumen y stock se ejecuta con la NUEVA cantidad.",
          "La validación de stock excluye el propio item del conteo de ya-asignados.",
          "Para incrementar/decrementar stock, calcula nuevo quantity y haz PUT."
        ]
      },

      "remove_item": {
        "method": "DELETE",
        "path": "/shelves/{shelf_id}/items/{item_id}",
        "auth": "shelves_update",
        "response": "204 No Content",
        "frontend_notes": [
          "Desasigna completamente el producto de la estantería.",
          "Alternativa: PUT item con quantity=0 hace lo mismo."
        ]
      }
    }
  },

    "categories": {
      "list": {
        "method": "GET",
        "path": "/categories/",
        "auth": "categories_read",
        "query": { "page": "int", "size": "int", "name": "string (ILIKE, documentado en Swagger)" },
        "response_shape": {
          "id": "int",
          "name": "string",
          "description": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        },
        "frontend_notes": [
          "name usa ILIKE: ?name=elec encuentra 'Electrodomésticos'.",
          "ProductForm usa este endpoint con ?name= para búsqueda on-demand de categorías."
        ]
      },
      "create": {
        "method": "POST",
        "path": "/categories/",
        "auth": "categories_create",
        "request_body": {
          "name": "string (1-100, requerido, único)",
          "description": "string|null (max 500)"
        },
        "response_shape": "mismo que list.items[0] (201 Created)",
        "errores": { "409": "Si name ya existe: 'La categoría ya existe'" }
      },
      "update": {
        "method": "PUT",
        "path": "/categories/{id}",
        "auth": "categories_update",
        "request_body": "Todos opcionales (partial update)",
        "response_shape": "mismo que list.items[0]"
      },
      "delete": {
        "method": "DELETE",
        "path": "/categories/{id}",
        "auth": "categories_delete",
        "response": "204 No Content"
      }
    },

    "sales": {
      "_intro": "Las ventas descuentan stock del producto y opcionalmente de estantería. Si shelf_id es null, solo descuenta stock del producto. Si shelf_id está presente, descuenta de la estantería Y del producto.",

      "list": {
        "method": "GET",
        "path": "/sales/",
        "auth": "sales_read",
        "query": { "page": "int", "size": "int", "_filtros": "customer_name (ILIKE), status (=), total (=), notes (ILIKE)" },
        "response_shape": {
          "id": "int",
          "customer_name": "string",
          "total": "float",
          "status": "string (COMPLETED|CANCELLED)",
          "notes": "string|null",
          "created_at": "ISO8601"
        }
      },

      "create": {
        "method": "POST",
        "path": "/sales/",
        "auth": "sales_create",
        "request_body": {
          "customer_name": "string (1-200, requerido)",
          "notes": "string|null (max 1000)",
          "items": [
            {
              "product_id": "int (requerido)",
              "shelf_id": "int|null (default null. Si null → solo descuenta stock producto. Si tiene valor → descuenta estantería + producto)",
              "quantity": "int (>=1, requerido)",
              "unit_price": "float (>0, requerido)"
            }
          ]
        },
        "response_shape": {
          "id": "int",
          "customer_name": "string",
          "total": "float",
          "status": "COMPLETED",
          "notes": "string|null",
          "created_at": "ISO8601",
          "created_by": "int (user_id)",
          "items": [
            {
              "id": "int",
              "product_id": "int",
              "product_name": "string",
              "shelf_id": "int|null",
              "shelf_code": "string|null",
              "quantity": "int",
              "unit_price": "float",
              "subtotal": "float"
            }
          ]
        },
        "errores": {
          "404": "Producto no encontrado o no asignado a estantería especificada",
          "409": "Stock insuficiente en producto o estantería"
        },
        "frontend_notes": [
          "Si shelf_id es null/omitido, solo se descuenta product.stock. No se toca estantería.",
          "Si shelf_id tiene valor, valida que producto esté en esa estantería con stock suficiente.",
          "La venta siempre descuenta product.stock sin importar shelf_id.",
          "Los items deben tener al menos 1 producto."
        ]
      },

      "get_detail": {
        "method": "GET",
        "path": "/sales/{id}",
        "auth": "sales_read",
        "response_shape": "mismo que create response"
      }
    },

    "orders": {
      "_intro": "Los pedidos tienen una máquina de estados: CREATED → PREPARING → READY → DELIVERED. Solo forward. Al hacer deliver, se crea una venta automáticamente. shelf_id es opcional como en sales.",

      "list": {
        "method": "GET",
        "path": "/orders/",
        "auth": "orders_read",
        "query": { "page": "int", "size": "int", "_filtros": "customer_name (ILIKE), status (=), total (=), notes (ILIKE)" },
        "response_shape": {
          "id": "int",
          "customer_name": "string",
          "total": "float",
          "status": "string (CREATED|PREPARING|READY|DELIVERED)",
          "notes": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601"
        }
      },

      "create": {
        "method": "POST",
        "path": "/orders/",
        "auth": "orders_create",
        "request_body": {
          "customer_name": "string (1-200, requerido)",
          "notes": "string|null (max 1000)",
          "items": [
            {
              "product_id": "int (requerido)",
              "shelf_id": "int|null (default null. Si se especifica, valida asignación + stock en estantería)",
              "quantity": "int (>=1, requerido)",
              "unit_price": "float (>0, requerido)"
            }
          ]
        },
        "response_shape": {
          "id": "int",
          "customer_name": "string",
          "total": "float",
          "status": "CREATED",
          "notes": "string|null",
          "created_at": "ISO8601",
          "updated_at": "ISO8601",
          "created_by": "int (user_id)",
          "items": [
            {
              "id": "int",
              "product_id": "int",
              "product_name": "string",
              "shelf_id": "int|null",
              "shelf_code": "string|null",
              "quantity": "int",
              "unit_price": "float",
              "subtotal": "float"
            }
          ]
        },
        "errores": {
          "404": "Producto no encontrado o no asignado a estantería especificada",
          "409": "Stock insuficiente en producto o estantería"
        },
        "frontend_notes": [
          "Al crear, valida stock actual de producto y estantería (si shelf_id especificado).",
          "El pedido no descuenta stock al crearse — solo valida disponibilidad.",
          "El descuento real ocurre al hacer deliver (cuando se crea la venta)."
        ]
      },

      "get_detail": {
        "method": "GET",
        "path": "/orders/{id}",
        "auth": "orders_read",
        "response_shape": "mismo que create response"
      },

      "prepare": {
        "method": "POST",
        "path": "/orders/{id}/prepare",
        "auth": "orders_manage",
        "request_body": null,
        "response_shape": "mismo que detail (status cambia a PREPARING)",
        "errores": { "409": "Transición inválida si no está en CREATED" },
        "frontend_notes": ["Cambia estado de CREATED a PREPARING. Solo forward."]
      },

      "ready": {
        "method": "POST",
        "path": "/orders/{id}/ready",
        "auth": "orders_manage",
        "request_body": null,
        "response_shape": "mismo que detail (status cambia a READY)",
        "errores": { "409": "Transición inválida si no está en PREPARING" }
      },

      "deliver": {
        "method": "POST",
        "path": "/orders/{id}/deliver",
        "auth": "orders_manage",
        "request_body": null,
        "response_shape": "mismo que detail (status cambia a DELIVERED)",
        "errores": { "409": "Transición inválida si no está en READY; o stock insuficiente al crear venta" },
        "frontend_notes": [
          "Crea una venta automáticamente con los items del pedido.",
          "Descuenta stock del producto y estantería (si shelf_id presente).",
          "Si la venta falla por stock insuficiente, el pedido NO cambia a DELIVERED.",
          "No re-valida stock de estantería más allá de lo que valida SaleService.create()."
        ]
      }
    },

    "flujo_frontend_tipico": {
    "buscar_producto_por_nombre_parcial": [
